{
  "openapi": "3.0.1",
  "info": {
    "title": "Demo Service",
    "version": "1.0.0.0"
  },
  "paths": {
    "/api/demo-models": {
      "get": {
        "tags": [
          "Demo"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number to retrieve (1-based index). Defaults to 1 if not specified.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of items to return per page. Defaults to 10 if not specified. Use 0 for unlimited single page request.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/DemoModelsSortBy"
                }
              ]
            }
          },
          {
            "name": "sortDir",
            "in": "query",
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortDirection"
                }
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedEnvelope<DemoModel<>>"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo-models/{id}": {
      "get": {
        "tags": [
          "Demo"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope<DemoModel<>>"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo-rpc-endpoint": {
      "post": {
        "tags": [
          "Demo"
        ],
        "parameters": [
          {
            "name": "X-Demo-Header-Parameter",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Demo-Required-Header",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/liveness": {
      "get": {
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Returns liveness state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health/readiness": {
      "get": {
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Returns readiness state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/Versions/{connectedServices}": {
      "get": {
        "tags": [
          "Versions"
        ],
        "description": "Retrieves version information.",
        "parameters": [
          {
            "name": "connectedServices",
            "in": "path",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request input data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MedusaErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DemoModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "clusteredJobCounter": {
            "type": "integer",
            "format": "int32"
          },
          "localJobCounter": {
            "type": "integer",
            "format": "int32"
          },
          "uniqueId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "DemoModelsSortBy": {
        "enum": [
          "Id",
          "Name"
        ],
        "type": "string"
      },
      "Envelope<DemoModel<>>": {
        "type": "object",
        "properties": {
          "content": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DemoModel"
              }
            ],
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MedusaErrorResponse": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": { }
          },
          "correlationId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PageDetails": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PagedEnvelope<DemoModel<>>": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DemoModel"
            }
          },
          "paging": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PageDetails"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "SortDirection": {
        "enum": [
          "Asc",
          "Desc"
        ],
        "type": "string"
      },
      "VersionInfo": {
        "type": "object",
        "properties": {
          "componentName": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "connectedServices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionInfo"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "JWT Authorization",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}