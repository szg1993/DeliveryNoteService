{
  "AllowedHosts": "*",
  "Versioning": {
    "ConnectedServiceVersionEndpoints": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Redoc": {
    "Enabled": false
  },
  "Persistence": {
    "ConnectionStrings": {
      "AppDb": "INSERT_CONNECTION_STRING"
    }
  },
  "Messaging": {
    "MessageBroker": {
      "Host": "INSERT_MQ_HOST",
      "Port": "INSERT_MQ_PORT",
      "User": "INSERT_MQ_USER",
      "Password": "INSERT_MQ_PASS"
    },
    "Channels": {
      "Outgoing": {
        "DemoOutgoingExchange": {
          "Exchange": "demo-outgoing-exchange",
          "RoutingKeys": {
            "DemoMessage": "demo-key"
          }
        },
        "DeadLettersDemoIncoming": {
          "Exchange": "dlx.demo-service.demo-data-source",
          "RoutingKeys": {
            "DemoMessage": "demo-dlx-routing-key"
          }
        }
      },
      "Incoming": {
        "DemoIncomingQueue": "demo-incoming-queue"
      }
    }
  },
  "Features": {
    "DemoJob": {
      "Enabled": false
    }
  },
  "Scheduling": {
    "DemoCron": "0 0 1 1 1 ? 2099"
  },
  "Diag": {
    "RequestLoggingEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Quartz": "Warning"
    }
  }
}