{
  "AllowedHosts": "*",
  "Versioning": {
    "ConnectedServiceVersionEndpoints": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Redoc": {
    "Enabled": false
  },
  "Persistence": {
    "ConnectionStrings": {
      "AppDb": "INSERT_CONNECTION_STRING"
    }
  },
  "Diag": {
    "RequestLoggingEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Quartz": "Warning"
    }
  }
}